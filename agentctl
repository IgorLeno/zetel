#!/usr/bin/env node
/**
 * Launcher publico extensionless.
 * Usa import() dinamico para carregar ESM sem exigir "type":"module" no package.json.
 */
import('./scripts/agentctl/cli.mjs')
  .then(({ runCli }) => {
    process.exitCode = runCli(process.argv.slice(2));
  })
  .catch((error) => {
    console.error(error);
    process.exitCode = 1;
  });
