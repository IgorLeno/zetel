# ─── E2E Live com OpenRouter — Módulo 12.1 ────────────────────────────────────
# Copie este arquivo para .env.e2e.live e preencha as variáveis.
# .env.e2e.live NÃO é commitado (ver .gitignore).
#
# Como rodar localmente:
#   cp .env.e2e.live.example .env.e2e.live
#   # editar .env.e2e.live com a chave e modelo
#   pnpm test:e2e:live
#
# Para rodar apenas um spec:
#   pnpm test:e2e:live e2e/live/study-guide-live.spec.ts
#   pnpm test:e2e:live e2e/live/chat-live.spec.ts
#
# Sem OPENROUTER_API_KEY os testes falham com mensagem clara.
# Sem ZETEL_E2E_LIVE=1 os describes são pulados (graceful skip).

# Ativa o projeto e2e-live no playwright.config.ts. OBRIGATÓRIO.
ZETEL_E2E_LIVE=1

# Chave OpenRouter. NÃO commitar. Use um modelo barato para testes.
OPENROUTER_API_KEY=

# Modelo para chat e geração do guia (opcional — usa default do app se vazio: openai/gpt-4o-mini).
# Outros baratos: deepseek/deepseek-chat, google/gemma-3-12b-it:free
ZETEL_E2E_MODEL=openai/gpt-4o-mini
ZETEL_E2E_STUDY_GUIDE_MODEL=

# Limite de tokens por geração de guia (padrão: 2048 para economizar créditos)
ZETEL_E2E_MAX_TOKENS=2048

# Limite de chamadas ao OpenRouter por execução (Fase 2: enforcement; Fase 1: apenas contagem)
ZETEL_E2E_MAX_CALLS=3

# Timeout total por chamada LLM em ms (padrão: 90 s)
ZETEL_E2E_TIMEOUT_MS=90000

# Fixture Markdown a usar (pasta: e2e/live/fixtures/<nome>.md)
ZETEL_E2E_FIXTURE=dft-mini
